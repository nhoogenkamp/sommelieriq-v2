{
    admin off
    persist_config off
    auto_https off

    log {
        format json
    }

    servers {
        trusted_proxies static private_ranges 100.0.0.0/8
    }
}

:{$PORT:3000} {

    handle /api/* {
        uri strip_prefix /api
        reverse_proxy sommelieriq-v2.railway.internal:8080
    }

    handle {
        root * dist
        encode gzip
        file_server
        try_files {path} /index.html
    }
}